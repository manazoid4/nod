{
  "name": "nod-core-app",
  "productName": "Nod Core",
  "version": "1.0.2",
  "description": "Nod Core desktop app: a native Windows client for the Nod Core host.",
  "private": true,
  "main": "dist/main/main.js",
  "author": "Nod",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "node scripts/dev.mjs --mock",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer && electron-builder --win nsis",
    "pack": "npm run build:main && npm run build:renderer && electron-builder --win --dir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "uk.nod.core",
    "productName": "Nod Core",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "build/icon.png", "build/tray.png", "package.json"],
    "extraResources": [
      {
        "from": "../host",
        "to": "core",
        "filter": ["mazhost/**/*", "*.ps1", "*.cmd", "requirements.txt", ".env.example", "!**/__pycache__/**", "!**/*.pyc"]
      },
      { "from": "../VERSION", "to": "core/VERSION" }
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nod Core"
    }
  }
}
